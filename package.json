{
  "name": "vscroll",
  "displayName": "VScroll",
  "description": "Read light novels and web articles inside VS Code.",
  "version": "0.0.1",
  "publisher": "ThiagoCosta360",
  "repository": { "type": "git", "url": "https://github.com/ThiagoCosta360/vscroll.git" },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscroll",
          "title": "VScroll",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "vscroll": [
        {
          "id": "vscroll.library",
          "name": "Library"
        },
        {
          "id": "vscroll.plugins",
          "name": "Plugins"
        }
      ]
    },
    "commands": [
      {
        "command": "vscroll.addNovel",
        "title": "VScroll: Add Novel",
        "icon": "$(add)"
      },
      {
        "command": "vscroll.addChapter",
        "title": "VScroll: Add Chapter to Novel"
      },
      {
        "command": "vscroll.removeNovel",
        "title": "VScroll: Remove Novel",
        "icon": "$(trash)"
      },
      {
        "command": "vscroll.openChapter",
        "title": "VScroll: Open Chapter"
      },
      {
        "command": "vscroll.openUrl",
        "title": "VScroll: Read URL"
      },
      {
        "command": "vscroll.refresh",
        "title": "VScroll: Refresh Library",
        "icon": "$(refresh)"
      },
      {
        "command": "vscroll.refreshPlugins",
        "title": "VScroll: Refresh Available Plugins",
        "icon": "$(refresh)"
      },
      {
        "command": "vscroll.installPlugin",
        "title": "VScroll: Install Plugin",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vscroll.uninstallPlugin",
        "title": "VScroll: Uninstall Plugin",
        "icon": "$(trash)"
      },
      {
        "command": "vscroll.browsePlugin",
        "title": "VScroll: Browse Plugin",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscroll.addNovel",
          "when": "view == vscroll.library",
          "group": "navigation@1"
        },
        {
          "command": "vscroll.refresh",
          "when": "view == vscroll.library",
          "group": "navigation@2"
        },
        {
          "command": "vscroll.refreshPlugins",
          "when": "view == vscroll.plugins",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vscroll.addChapter",
          "when": "view == vscroll.library && viewItem == novel",
          "group": "inline"
        },
        {
          "command": "vscroll.removeNovel",
          "when": "view == vscroll.library && viewItem == novel"
        },
        {
          "command": "vscroll.browsePlugin",
          "when": "view == vscroll.plugins && (viewItem == plugin.builtin || viewItem == plugin.installed)",
          "group": "inline"
        },
        {
          "command": "vscroll.uninstallPlugin",
          "when": "view == vscroll.plugins && viewItem == plugin.installed",
          "group": "inline"
        },
        {
          "command": "vscroll.installPlugin",
          "when": "view == vscroll.plugins && viewItem == plugin.available",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "VScroll",
      "properties": {
        "vscroll.userAgent": {
          "type": "string",
          "default": "Mozilla/5.0 (compatible; VScroll/0.1)",
          "description": "User-Agent header to use when fetching chapters."
        },
        "vscroll.fontSize": {
          "type": "number",
          "default": 0,
          "description": "Reader font size in pixels. 0 = use the editor font size."
        },
        "vscroll.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Reader font family. Leave empty to use the editor font."
        },
        "vscroll.maxWidth": {
          "type": "number",
          "default": 800,
          "description": "Reader max content width in pixels."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "cheerio": "^1.2.0",
    "jsdom": "^24.0.0"
  }
}
